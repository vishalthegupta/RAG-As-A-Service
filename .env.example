# Application
APP_NAME=RAG-as-a-Service
VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# Security - CHANGE THESE IN PRODUCTION
# Generate JWT_SECRET_KEY with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
SYNC_DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_data

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# RAG Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.8
RAG_MAX_HISTORY_MESSAGES=6
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Rate Limiting
CHAT_RATE_LIMIT=60/minute

# CORS - Frontend URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
